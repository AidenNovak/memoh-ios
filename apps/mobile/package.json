{
  "name": "@memoh-ios/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --no-install",
    "pods": "cd ios && pod install",
    "bundle": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform ios --output-dir .expo/export-check",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node ./scripts/check-locales.mjs",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test 'tests/**/*.test.mjs' && python3 verification/runner_test.py && python3 verification/simulator_test.py && python3 verification/build_test.py",
    "verify:build": "python3 verification/build.py",
    "verify:ui": "python3 verification/ui/run.py",
    "verify:native": "python3 verification/native.py",
    "verify:simulator": "python3 verification/simulator.py",
    "verify:clean": "python3 verification/clean.py"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
